# AltarExtractor Configuration
# Copy this file to .env and fill in your values

# MongoDB host (default: localhost)
# Use "mongo" if running in Docker alongside MongoDB
ALTAR_MONGO_HOST=localhost

# MongoDB port (default: 27017)
ALTAR_MONGO_PORT=27017

# MongoDB username (leave empty if no auth)
ALTAR_MONGO_USERNAME=

# MongoDB password (leave empty if no auth)
ALTAR_MONGO_PASSWORD=

# MongoDB auth source (default: admin)
# Use "admin" if your user is created in the admin database
# Use "auto" to use the selected database name as authSource
# Or specify a specific database name
ALTAR_MONGO_AUTH_SOURCE=admin

# Optional: Comma-separated list of allowed database names
# If not set, all databases will be shown
# Example: ALTAR_ALLOWED_DATABASES=sacred,experiments,ml_runs
ALTAR_ALLOWED_DATABASES=

# Debug mode (set to true for development)
ALTAR_DEBUG=false
